<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ProjectManagerMobile.Views.CreateSprintPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:ProjectManagerMobile.Utilities.Converters"
    xmlns:dx="http://schemas.devexpress.com/maui"
    Title="Create sprint"
    BackgroundColor="{DynamicResource SecondaryBackgroundColor}">

    <ContentPage.Resources>
        <converters:PriorityToColorConverter x:Key="PriorityToColorConverter" />
    </ContentPage.Resources>

    <Grid Padding="20,0,20,20" RowDefinitions="*, Auto">
        <ScrollView>

            <VerticalStackLayout Grid.Row="0">
                <Label
                    Margin="0,20,0,0"
                    FontFamily="SourceSansBold"
                    FontSize="18"
                    Text="Name"
                    TextColor="{DynamicResource PrimaryTextColor}" />

                <Entry
                    FontFamily="SourceSansRegular"
                    FontSize="20"
                    Text="{Binding SprintName}"
                    TextColor="{DynamicResource SecondaryTextColor}" />


                <Label
                    Margin="0,20,0,0"
                    FontFamily="SourceSansBold"
                    FontSize="18"
                    Text="Description"
                    TextColor="{DynamicResource PrimaryTextColor}" />


                <Editor
                    AutoSize="TextChanges"
                    FontFamily="SourceSansRegular"
                    FontSize="20"
                    Text="{Binding SprintDescription}"
                    TextColor="{DynamicResource SecondaryTextColor}" />

                <Label
                    Margin="0,20,0,0"
                    FontFamily="SourceSansBold"
                    FontSize="18"
                    Text="Work period"
                    TextColor="{DynamicResource PrimaryTextColor}" />

                <HorizontalStackLayout Margin="5" HorizontalOptions="Center">

                    <Border
                        Padding="25,0"
                        BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                        StrokeShape="RoundRectangle 12">
                        <DatePicker
                            Date="{Binding StartDate}"
                            FontFamily="SourceSansRegular"
                            Format="dd/MM/yyyy"
                            MaximumDate="12/31/2030"
                            MinimumDate="01/01/2020"
                            VerticalOptions="Center" />
                    </Border>

                    <Border
                        BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                        HeightRequest="10"
                        WidthRequest="40" />
                    <Border
                        Padding="25,0"
                        BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                        StrokeShape="RoundRectangle 12">
                        <DatePicker
                            Date="{Binding EndDate}"
                            FontFamily="SourceSansRegular"
                            Format="dd/MM/yyyy"
                            MaximumDate="12/31/2030"
                            MinimumDate="01/01/2020"
                            VerticalOptions="Center" />
                    </Border>

                </HorizontalStackLayout>

                <HorizontalStackLayout Margin="0,20,0,0" Spacing="10">
                    <Label
                        FontFamily="SourceSansBold"
                        FontSize="18"
                        Text="Tasks"
                        TextColor="{DynamicResource PrimaryTextColor}"
                        VerticalOptions="Center" />

                    <Button
                        BackgroundColor="Transparent"
                        Command="{Binding GoToCreateTaskCommand}"
                        CornerRadius="24"
                        FontFamily="SourceSansRegular"
                        FontSize="16"
                        Text="Add task"
                        TextColor="{DynamicResource PrimaryTextColor}" />
                </HorizontalStackLayout>

                <dx:DXCollectionView
                    x:Name="TasksCollectionView"
                    Margin="10"
                    ItemsSource="{Binding Tasks}"
                    SelectionMode="None">

                    <dx:DXCollectionView.ItemTemplate>
                        <DataTemplate>
                            <dx:SwipeContainer FullSwipeMode="Both">
                                <dx:SwipeContainer.ItemView>

                                    <Border
                                        Margin="5"
                                        Padding="0"
                                        BackgroundColor="Transparent"
                                        StrokeShape="RoundRectangle 10"
                                        StrokeThickness="0">

                                        <Grid ColumnDefinitions="*, *" ColumnSpacing="0">

                                            <Border
                                                Grid.Column="0"
                                                BackgroundColor="{DynamicResource PrimaryColor}"
                                                Stroke="Transparent"
                                                StrokeShape="RoundRectangle 10 0 10 0">
                                                <Label
                                                    Padding="10"
                                                    FontSize="16"
                                                    HorizontalOptions="Center" HorizontalTextAlignment="Center"
                                                    Text="{Binding Name}"
                                                    TextColor="White"
                                                    VerticalOptions="Center" />
                                            </Border>

                                            <Border
                                                Grid.Column="1"
                                                BackgroundColor="{Binding Priority, Converter={StaticResource PriorityToColorConverter}}"
                                                Stroke="Transparent"
                                                StrokeShape="RoundRectangle 0 10 0 10">
                                                <Label
                                                    Padding="10"
                                                    FontSize="16"
                                                    HorizontalOptions="Center"
                                                    Text="{Binding Priority}"
                                                    TextColor="{DynamicResource SecondaryTextColor}"
                                                    VerticalOptions="Center" />
                                            </Border>

                                        </Grid>
                                    </Border>

                                </dx:SwipeContainer.ItemView>

                                <dx:SwipeContainer.StartSwipeItems>
                                    <dx:SwipeContainerItem
                                        BackgroundColor="Red"
                                        Caption="Remove"
                                        Command="{Binding Path=BindingContext.DeleteTaskCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                        CommandParameter="{Binding .}"
                                        FontAttributes="Bold"
                                        FontColor="White"
                                        FontSize="16" />
                                </dx:SwipeContainer.StartSwipeItems>

                                <dx:SwipeContainer.EndSwipeItems>
                                    <dx:SwipeContainerItem
                                        BackgroundColor="Red"
                                        Caption="Remove"
                                        Command="{Binding Path=BindingContext.DeleteTaskCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                        CommandParameter="{Binding .}"
                                        FontAttributes="Bold"
                                        FontColor="White"
                                        FontSize="16" />
                                </dx:SwipeContainer.EndSwipeItems>

                            </dx:SwipeContainer>
                        </DataTemplate>
                    </dx:DXCollectionView.ItemTemplate>
                </dx:DXCollectionView>


               
            </VerticalStackLayout>

        </ScrollView>

        <Button
            Grid.Row="1"
            Margin="0,20,0,0"
            Padding="0,15"
            BackgroundColor="{DynamicResource PrimaryColor}"
            Command="{Binding CreateSprintCommand}"
            CornerRadius="28"
            FontFamily="SourceSansRegular"
            FontSize="18"
            Text="Create sprint"
            TextColor="{DynamicResource OnPrimaryColor}" />
    </Grid>

</ContentPage>