<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="ProjectManagerMobile.Views.Popups.ProjectSettingsPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Color="Transparent">

    <Border Padding="20" Background="{DynamicResource SecondaryBackgroundColor}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="30" />
        </Border.StrokeShape>

        <VerticalStackLayout Spacing="10" WidthRequest="350">

            <Label
                FontFamily="SourceSansRegular"
                FontSize="26"
                HorizontalOptions="Center"
                Text="Select action"
                TextColor="{DynamicResource PrimaryTextColor}" />

            <Button
                BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                Command="{Binding GoToEditToProjectCommand}"
                CornerRadius="20"
                FontSize="22" FontFamily="SourceSansRegular"
                HeightRequest="60" Clicked="Button_Clicked"
                Text="Edit project"
                TextColor="{DynamicResource SecondaryTextColor}" />
            <Button
                BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                Command="{Binding ShowInvitationPopupCommand}"
                CornerRadius="20"
                FontSize="22"
                HeightRequest="60" Clicked="Button_Clicked"
                Text="Add participants" FontFamily="SourceSansRegular"
                TextColor="{DynamicResource SecondaryTextColor}" />

            <Button
                BackgroundColor="{DynamicResource PrimaryBackgroundColor}"
                Command="{Binding GoToCreateSprintCommand}"
                CornerRadius="20"
                FontSize="22"
                HeightRequest="60" Clicked="Button_Clicked"
                Text="Create new sprint" FontFamily="SourceSansRegular"
                TextColor="{DynamicResource SecondaryTextColor}" />

        </VerticalStackLayout>
    </Border>

</toolkit:Popup>
